EMBEDDING_MAX_SEQ_LENGTH=512
CHUNK_SIZE_DEFAULT=256
CHUNK_OVERLAP_DEFAULT=32
CHUNK_SIZE_STRUCTURED=192
CHUNK_OVERLAP_STRUCTURED=24
CHUNK_SIZE_MAX=512
CHUNK_STRUCTURE_MIN_LINES=3
CHUNK_STRUCTURE_HEADING_RATIO=0.20
GRAPH_MAX_HOPS=3
GRAPH_BEAM_WIDTH=24
GRAPH_PRUNE_THRESHOLD=0.10
HYBRID_ENABLED=true
HYBRID_GRAPH_WEIGHT=0.62
HYBRID_EMBEDDING_WEIGHT=0.23
HYBRID_LEXICAL_WEIGHT=0.15
RERANKER_ENABLED=false
